# Database Postgres (Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgres://user:password@host:5432/elerent

# Account admin Atom che vede tutte le città (mai nel codice o in chat)
ATOM_EMAIL=
ATOM_PASSWORD=
# Opzionali
ATOM_BASE_URL=https://app.rideatom.com
ATOM_AUTH_SCHEME=Bearer
# Stati Atom aggiuntivi da considerare "fuori strada", separati da virgola
ATOM_OFF_STREET_STATUSES=

# Firma dei cookie di login: almeno 32 caratteri casuali (es. `openssl rand -hex 32`)
SESSION_SECRET=

# Protegge il job giornaliero chiamato da Vercel Cron
CRON_SECRET=

# Primo accesso: se il database non ha utenti, chi entra con queste credenziali diventa amministratore
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notifiche push agli utenti (OneSignal > Settings > Keys & IDs). Senza queste la pagina Notifiche prepara solo i testi.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Come l'app registra gli utenti in OneSignal come External ID: atom_id (default), email o phone
ONESIGNAL_EXTERNAL_ID=atom_id
# Opzionale: External ID dei telefoni di prova separati da virgola. Se vuoto, le prove vanno al segmento "Test Users" di OneSignal
ONESIGNAL_TEST_EXTERNAL_IDS=
